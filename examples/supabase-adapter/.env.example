# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Use the service role key for server-side usage (bypasses RLS)
# Or use the anon key if you have appropriate RLS policies configured
SUPABASE_KEY=your-service-role-key-or-anon-key

# Optional: Custom table name (defaults to 'triplit_kv_store')
SUPABASE_TABLE_NAME=triplit_kv_store
