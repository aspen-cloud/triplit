# Supabase Configuration for SQL Adapter
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# IMPORTANT: Use the SERVICE ROLE key, not the anon key
# The SQL adapter requires service role permissions to:
# - Execute raw SQL for migrations
# - Call RPC functions for query execution
# - Introspect database schema
SUPABASE_KEY=your-service-role-key

# Optional: Schema to use (defaults to 'public')
SUPABASE_SCHEMA=public
